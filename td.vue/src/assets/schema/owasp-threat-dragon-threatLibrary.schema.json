{
  "$id": "https://github.com/OWASP/threat-dragon/tree/main/td.vue/src/assets/schema/owasp-threat-dragon-threatLibrary.schema.json",
  "title": "Threat Dragon threat library schema",
  "description": "The threat library format used for import and export of catalogue threats in OWASP Threat Dragon",
  "type": "object",
  "properties": {
    "threatLibrary": {
      "description": "Array of threat library entries",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "description": "The threat title",
            "type": "string"
          },
          "modelType": {
            "description": "The threat modelling framework, e.g. STRIDE, LINDDUN, CIA, CIADIE, PLOT4ai",
            "type": "string"
          },
          "type": {
            "description": "The threat type, selection according to modelType",
            "type": "string"
          },
          "description": {
            "description": "The full threat description",
            "type": "string"
          },
          "mitigations": {
            "description": "Mitigations for this threat, embedded in full so the library file is portable between deployments",
            "type": "array",
            "default": [],
            "items": {
              "type": "object",
              "properties": {
                "title": {
                  "description": "The mitigation title",
                  "type": "string"
                },
                "description": {
                  "description": "The full mitigation description",
                  "type": "string"
                },
                "clauses": {
                  "description": "Compliance clauses this mitigation satisfies",
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "standard": {
                        "description": "Name of the compliance standard",
                        "type": "string"
                      },
                      "clause": {
                        "description": "Specific clause or control reference within the standard",
                        "type": "string"
                      }
                    },
                    "required": ["standard", "clause"]
                  }
                }
              },
              "required": ["title", "description"]
            }
          },
          "tags": {
            "description": "Optional tags for filtering and categorisation",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "score": {
            "description": "The custom score or risk rating for the threat",
            "type": "string"
          },
          "severity": {
            "description": "The default severity level for the threat: TBD, Low, Medium, High or Critical",
            "type": "string",
            "enum": ["TBD", "Low", "Medium", "High", "Critical"]
          }
        },
        "required": [ "title", "modelType", "type", "description" ]
      }
    }
  },
  "required": [ "threatLibrary" ]
}
